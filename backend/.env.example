# Copy to .env and fill in. .env is gitignored (see top-level .gitignore).
#
# The backend prefers OPENAI when set, otherwise falls back to GROQ, otherwise
# to a local stub (the dashboard still loads — only the AI coaching falls back).

# OpenAI — required for AI coaching responses on the demo branch.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override. Default is gpt-4o-mini (fast, inexpensive, JSON mode).
# OPENAI_MODEL=gpt-4o-mini

# Groq — alternative provider. Used only if OPENAI_API_KEY is empty.
# https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
